#!/usr/bin/env bash
# Hook: TaskCompleted
# Conditional auto-commit when dynos_auto_commit is enabled in Claude project settings.
set -u

PROJECT_ROOT="${CLAUDE_PROJECT_DIR:-$(pwd)}"
PROJECT_DIR="${PROJECT_ROOT//\//-}"
for SETTINGS in "$HOME/.claude/projects/$PROJECT_DIR/settings.json" "${PROJECT_ROOT}/.claude/settings.local.json"; do
  if [ -f "$SETTINGS" ] && grep -q '"dynos_auto_commit"[[:space:]]*:[[:space:]]*true' "$SETTINGS" 2>/dev/null; then
    cd "${PROJECT_ROOT}" && git add .dynos/ benchmarks/ 2>/dev/null && (git diff --cached --quiet || git commit -m "dynos-work: auto-commit after task completion" >/dev/null 2>&1) || true
    break
  fi
done
