#!/usr/bin/env bash
# Hook: SubagentStop — capture token usage from subagent transcripts
# Fast-path C binary skips empty/missing transcripts and non-dynos repos (~1ms);
# otherwise invokes a single Python process (lib_tokens_hook.py --from-stdin).
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FAST_BIN="${SCRIPT_DIR}/bin/dynos-fast"
PAYLOAD="$(cat)"
if [ -x "${FAST_BIN}" ]; then
  rc=0
  printf '%s' "${PAYLOAD}" | "${FAST_BIN}" --subagent-tokens || rc=$?
  if [ "$rc" -eq 0 ]; then
    exit 0
  fi
fi
PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}" printf '%s' "${PAYLOAD}" | python3 "${SCRIPT_DIR}/lib_tokens_hook.py" --from-stdin 2>/dev/null || true
