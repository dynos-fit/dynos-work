#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
PROJECT_ROOT="${CLAUDE_PROJECT_DIR:-$(pwd)}"

HOOK_PAYLOAD="$(cat 2>/dev/null || true)"
ROUTING_SUMMARY=$(printf '%s' "${HOOK_PAYLOAD}" | PYTHONPATH="${SCRIPT_DIR}:${PYTHONPATH:-}" python3 "${SCRIPT_DIR}/session_start_hook.py" "${PROJECT_ROOT}" 2>/dev/null || echo "defaults only")

session_context="dynos-work active. Routing: ${ROUTING_SUMMARY:-defaults only}. IMPORTANT: dynos-work commands are user-invoked only. Run one only when the user explicitly types its full namespaced form (/dynos-work:start, /dynos-work:resume, /dynos-work:audit, and so on). Never start, resume, audit, or otherwise enter the dynos-work pipeline on your own initiative, and do not treat a task-shaped request, a session restart, or words like 'resume' or 'status' as an invocation. When the user has explicitly invoked /dynos-work:execute or /dynos-work:audit, run router.py first for deterministic model/skip/route decisions before spawning agents."

if [ -n "${CLAUDE_PLUGIN_ROOT:-}" ]; then
  printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$session_context"
else
  printf '{\n  "additional_context": "%s"\n}\n' "$session_context"
fi

exit 0
