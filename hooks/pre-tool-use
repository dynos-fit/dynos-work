#!/usr/bin/env bash
# PreToolUse hook for dynos-work write/read-policy enforcement.
# Fast-path C filter exits immediately (~1ms) on safe non-task reads/calls;
# delegates all other calls to Python pre_tool_use.py.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
FAST_BIN="${SCRIPT_DIR}/bin/dynos-fast"
if [ -x "${FAST_BIN}" ]; then
  PAYLOAD="$(cat)"
  rc=0
  printf '%s' "${PAYLOAD}" | "${FAST_BIN}" --pre-tool-use || rc=$?
  if [ "$rc" -eq 0 ]; then
    exit 0
  fi
  exec python3 "${SCRIPT_DIR}/pre_tool_use.py" <<<"${PAYLOAD}"
fi
exec python3 "${SCRIPT_DIR}/pre_tool_use.py"
