{
  "version": 1,
  "hooks": {
    "preToolUse": [
      {
        "matcher": "Write|Shell|StrReplace",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run-hook.cmd\" pre-tool-use",
        "failClosed": true
      },
      {
        "matcher": "Task",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run-hook.cmd\" agent-spawn-log pre",
        "failClosed": true
      }
    ],
    "postToolUse": [
      {
        "matcher": "Task",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run-hook.cmd\" agent-spawn-log post"
      },
      {
        "matcher": "WebSearch|WebFetch",
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run-hook.cmd\" web-tool-log"
      }
    ],
    "sessionStart": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run-hook.cmd\" session-start"
      }
    ],
    "stop": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run-hook.cmd\" task-completed"
      }
    ],
    "subagentStop": [
      {
        "command": "bash \"${CURSOR_PLUGIN_ROOT}/hooks/run-hook.cmd\" subagent-tokens"
      }
    ]
  }
}
